{
  "schema": 1,
  "id": "openclaw.install",
  "title": "OpenClaw gateway",
  "summary": "Install OpenClaw into its own pnpm project and apply the Android patches",
  "category": "agents",
  "requires": {
    "arch": ["aarch64", "armv8l", "x86_64"],
    "min_mem_mb": 900,
    "min_disk_mb": 2500,
    "tools": ["node", "pnpm"]
  },
  "steps": [
    { "id": "stop", "title": "Stop running gateway", "run": "step_pm2_stop",
      "args": { "name": "openclaw" }, "optional": true },
    { "id": "install", "title": "Install into its own project",
      "run": "step_pnpm_tool",
      "args": { "tool": "openclaw", "name": "openclaw", "spec": "latest" },
      "retry_on_sigkill": 2 },
    { "id": "patches", "title": "Apply Android patches", "run": "step_openclaw_patches" },
    { "id": "verify", "title": "Verify", "run": "step_verify_cmd",
      "args": { "cmd": ["openclaw", "--version"] } }
  ]
}
