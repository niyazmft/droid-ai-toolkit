{
  "schema": 1,
  "id": "ollama.install",
  "title": "Ollama",
  "summary": "Install the Ollama runtime. Model weights are downloaded separately with `ollama pull`.",
  "category": "utilities",
  "requires": { "arch": ["aarch64", "armv8l", "x86_64"], "min_disk_mb": 1500 },
  "steps": [
    { "id": "install", "title": "Install package", "run": "step_pkg_install",
      "args": { "packages": ["ollama"] }, "idempotent": true },
    { "id": "verify", "title": "Verify", "run": "step_verify_cmd",
      "args": { "cmd": ["ollama", "--version"], "timeout_s": 60 } }
  ]
}
