{
  "schema": 1,
  "id": "gemini.install",
  "title": "Gemini CLI",
  "summary": "Install Google's Gemini CLI and apply the Android rename patch",
  "category": "utilities",
  "requires": {
    "arch": [
      "aarch64",
      "armv8l",
      "x86_64"
    ],
    "min_mem_mb": 512,
    "min_disk_mb": 1500,
    "tools": [
      "node",
      "pnpm"
    ]
  },
  "steps": [
    {
      "id": "deps",
      "title": "Ensure build tools",
      "run": "step_pkg_install",
      "args": {
        "packages": [
          "python",
          "make",
          "clang",
          "pkg-config"
        ]
      },
      "optional": true,
      "idempotent": true
    },
    {
      "id": "install",
      "title": "Install into its own project",
      "run": "step_pnpm_tool",
      "args": {
        "tool": "gemini",
        "name": "@google/gemini-cli",
        "spec": "latest"
      },
      "retry_on_sigkill": 2,
      "idempotent": true
    },
    {
      "id": "patch",
      "title": "Apply Android patch",
      "run": "step_gemini_patch",
      "optional": true,
      "idempotent": true
    },
    {
      "id": "verify",
      "title": "Verify",
      "run": "step_verify_cmd",
      "args": {
        "cmd": [
          "gemini",
          "--version"
        ]
      }
    }
  ]
}
